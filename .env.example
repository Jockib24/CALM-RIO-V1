# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True

# Hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Production (MySQL on o2switch):
# DATABASE_URL=mysql://user:password@host:port/dbname
#
# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:port/dbname
#
# Local development (SQLite — default):
DATABASE_URL=sqlite:///db.sqlite3

# Media files root (optional — defaults to BASE_DIR/media)
# MEDIA_ROOT=/home/calmrio/www/media

# Email
CONTACT_EMAIL=contact@calm-rio.com
DEFAULT_FROM_EMAIL=CalmRio <contact@calm-rio.com>
EMAIL_HOST=smtp.host.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@calm-rio.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True

# Logging (DEBUG, INFO, WARNING, ERROR)
# DJANGO_LOG_LEVEL=WARNING
