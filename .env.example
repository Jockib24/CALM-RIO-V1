# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True

# Hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite used by default in local.py)
# For PostgreSQL, uncomment and set:
# DB_NAME=calmrio
# DB_USER=calmrio
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Contact / Email
CONTACT_EMAIL=contact@calm-rio.com
DEFAULT_FROM_EMAIL=CalmRio <contact@calm-rio.com>

# Email backend (console for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
