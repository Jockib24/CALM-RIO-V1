msgid "&ldquo;Charmante maison et emplacement paisible. Un s&eacute;jour d'une semaine o&ugrave; tout le confort est l&agrave;, on se sent tr&egrave;s bien dans leur belle propri&eacute;t&eacute; d&eacute;cor&eacute;e avec go&ucirc;t, qui dispose de deux belles terrasses avec un petit jardin privatif en herbe et cl&ocirc;tur&eacute;, id&eacute;al pour notre beagle&nbsp;!&rdquo;"
msgstr ""

msgid "&ldquo;Le s&eacute;jour s'est tr&egrave;s bien pass&eacute;. Le logement &eacute;tait incroyable&nbsp;: tr&egrave;s grand, tr&egrave;s propre, tr&egrave;s fonctionnel, moderne, cuisine tr&egrave;s bien &eacute;quip&eacute;e, terrasses et jardin tr&egrave;s agr&eacute;ables, proche de la mer, propri&eacute;taires tr&egrave;s gentils.&rdquo;"
msgstr ""

msgid "&ldquo;Maison magnifique, avec un jardin paisible offrant un bel espace pour se reposer et se ressourcer. Les propri&eacute;taires sont des personnes accueillantes et chaleureuses.&rdquo;"
msgstr ""

msgid "&ldquo;Nous avons pass&eacute; un excellent s&eacute;jour dans la maison d'Agn&egrave;s. Elle est situ&eacute;e dans un tr&egrave;s bel environnement et tr&egrave;s proche de la mer &agrave; pieds ou en v&eacute;lo. La maison est spacieuse, confortable et tr&egrave;s bien &eacute;quip&eacute;e. Nous reviendrons certainement.&rdquo;"
msgstr ""

msgid "&ldquo;Nous avons pass&eacute; une superbe semaine au calme dans une jolie villa bien &eacute;quip&eacute;e et bien plac&eacute;e. L'accueil &eacute;tait tr&egrave;s bon et r&eacute;actif. Nous reviendrons avec plaisir.&rdquo;"
msgstr ""

